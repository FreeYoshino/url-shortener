# Copy this file to .env.production and fill in real values.
#
# This file is NOT loaded automatically. 
# Every command must pass --env-file so compose can interpolate these values. 

# PostgreSQL Database Configuration
DB_USERNAME=url_shortener
DB_PASSWORD=change-me-to-a-long-random-string
DB_DATABASE=url_shortener

# Server Configuration
# Host port the app is published on; the container always listens on 3000.
APP_PORT=3000

# Rate Limiting 
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=30
THROTTLE_WRITE_LIMIT=10
THROTTLE_REDIRECT_LIMIT=60

# Redis Configuration
REDIS_PASSWORD=change-me-to-a-long-random-url-safe-string
URL_CACHE_TTL_MS=60000

# API surface / demo exposure
# Set to the literal "false" to unmount PUT / DELETE / statistics. Anything else = mounted.
ENABLE_ADMIN_API=false
# Comma-separated exact hostnames (no scheme, port, path or wildcard).
# Unset or empty = no host restriction; targets are still limited to http/https.
# An invalid entry stops the app at startup.
DEMO_ALLOWED_HOSTS=github.com,example.com
# Please copy this file to .env and fill in the values for your environment.

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=user
DB_PASSWORD=password
DB_DATABASE=db
DATABASE_URL=postgresql://user:password@localhost:5432/db?schema=public

# Server Configuration
PORT=3000

# Rate Limiting
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=30
# custom limits for write and redirect endpoints
THROTTLE_WRITE_LIMIT=10
THROTTLE_REDIRECT_LIMIT=60

# Redis Configuration
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
URL_CACHE_TTL_MS=60000

# API surface / demo exposure
# Set to the literal "false" to unmount PUT / DELETE / statistics. Anything else = mounted.
ENABLE_ADMIN_API=true
# Comma-separated exact hostnames (no scheme, port, path or wildcard).
# Unset or empty = no host restriction; targets are still limited to http/https.
# An invalid entry stops the app at startup.
DEMO_ALLOWED_HOSTS=